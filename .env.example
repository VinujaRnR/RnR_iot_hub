# ==========================================
# Hub Identification & Prefetch
# ==========================================
HUB_ID=hub-01
RABBITMQ_PREFETCH=10

# ==========================================
# RabbitMQ Remote Broker Connection
# (Either provide RABBITMQ_URL or discrete fields below)
# ==========================================
# RABBITMQ_URL=amqps://iot_user:password@broker.example.com:5671/%2F
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_USE_SSL=false

# ==========================================
# RabbitMQ Command Routing Configuration
# ==========================================
RABBITMQ_COMMAND_EXCHANGE=iot_commands
RABBITMQ_COMMAND_QUEUE=iot.hub.hub-01.commands
RABBITMQ_COMMAND_ROUTING_KEY=iot.command

# ==========================================
# Operational & Storage Settings
# ==========================================
SCHEDULE_TIMEZONE=Asia/Kolkata
DATABASE_PATH=iothub.db

# ==========================================
# Hardware & Microcontroller Settings
# ==========================================
USB_BAUD_RATE=115200
USB_SCAN_INTERVAL=5
COMMAND_TIMEOUT_SECONDS=5

# ==========================================
# Local Management API Settings
# ==========================================
API_HOST=127.0.0.1
API_PORT=8765

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
